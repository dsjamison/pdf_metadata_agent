# Select a PydanticAI model. Uncomment one of the alternatives to switch providers.
PDF_METADATA_MODEL=anthropic:claude-sonnet-4-6
# PDF_METADATA_MODEL=openai:gpt-5.2
# PDF_METADATA_MODEL=google-gla:gemini-2.5-flash
# PDF_METADATA_MODEL=meta:muse-spark-1.3-contributor

# Add the key for the selected provider. Leave unused keys empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1

# How many leading pages to send to the model. The full file is kept for
# file size and page count; only the front matter is sent for extraction.
PDF_METADATA_MAX_PAGES=10
